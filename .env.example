# =======================================================
# 1. SITO E SISTEMA
# =======================================================
DOMAIN=tuosito.com
ADMIN_EMAIL=admin@tuosito.com
TZ=Europe/Rome

# Lingua con cui scaricare WordPress alla prima installazione
# (it_IT, de_DE, fr_FR...). Vuoto = inglese.
WORDPRESS_LOCALE=it_IT

# =======================================================
# 2. PHP
# =======================================================
# Versione usata per servire il sito: 8.3, 8.4 o 8.5.
#
# A differenza dello stack OpenLiteSpeed, qui PHP_VERSION e' SOLO runtime:
# l'immagine contiene tutte e tre le versioni e per cambiarla basta
# riavviare il container. Nessun rebuild.
PHP_VERSION=8.3

# Quali versioni finiscono nell'immagine (questo si', richiede rebuild).
# Ridurre la lista alleggerisce l'immagine di qualche centinaio di MB.
#
# Separate da virgola, non da spazi: il valore attraversa il .env, il
# parser di Compose e la riscrittura che Dokploy fa del file per
# iniettare le label Traefik, e uno spazio ha piu' occasioni di perdersi
# per strada. Lo spazio funziona comunque, se preferisci.
PHP_VERSIONS=8.3,8.4,8.5

# memory_limit degli script web
PHP_MEM_LIMIT=512M
# memory_limit di WP-CLI: import, migrazioni e rigenerazione miniature
# hanno bisogno di piu' spazio di una pagina web
PHP_CLI_MEM_LIMIT=1024M
# Numero massimo di worker PHP-FPM contemporanei.
# Regola pratica: PHP_CONCURRENCY x PHP_MEM_LIMIT non deve superare
# WP_MEM_LIMIT, altrimenti sotto carico interviene l'OOM killer.
PHP_CONCURRENCY=20
# Upload massimo (vale insieme per PHP e per nginx)
PHP_UPLOAD_LIMIT=128M
PHP_MAX_EXECUTION_TIME=300
# Ricicla il worker dopo N richieste: contiene le perdite di memoria dei plugin
PHP_FPM_MAX_REQUESTS=500
# Oltre questa soglia la richiesta finisce nel log delle lente con lo stack PHP
PHP_SLOWLOG_TIMEOUT=10s

# Funzioni disattivate nelle sole richieste web (WP-CLI non e' toccato).
# Lasciare vuoto per usare la lista di default dell'entrypoint; scrivere
# una lista propria la sostituisce.
PHP_DISABLE_FUNCTIONS=

# --- OPcache ---
OPCACHE_MEMORY=192
OPCACHE_MAX_FILES=20000
# JIT: su WordPress il guadagno e' vicino a zero, il collo di bottiglia
# sono query e I/O. "disable" oppure "tracing" con un buffer > 0.
OPCACHE_JIT=disable
OPCACHE_JIT_BUFFER=0

# =======================================================
# 3. VARNISH (full page cache)
# =======================================================
# RAM della cache pagine. E' la voce che sposta di piu' il tempo di
# risposta: una pagina in HIT esce in pochi millisecondi senza svegliare
# PHP ne' il database.
VARNISH_SIZE=256m
# Limite RAM del container: deve stare sopra VARNISH_SIZE, perche' oltre
# agli oggetti Varnish alloca thread e strutture interne.
VARNISH_MEM_LIMIT=512M

# TTL delle pagine HTML. Alto quanto si vuole: i plugin di purge
# invalidano le pagine quando il contenuto cambia davvero.
VARNISH_TTL=6h
# TTL degli asset statici
VARNISH_STATIC_TTL=7d
# Finestra in cui Varnish continua a servire una copia scaduta mentre
# rigenera in background. E' anche cio' che tiene in piedi il sito in
# sola lettura se PHP smette di rispondere.
VARNISH_GRACE=24h

VARNISH_THREAD_POOLS=2
VARNISH_THREAD_MIN=100
VARNISH_THREAD_MAX=1000

# =======================================================
# 3-bis. CACHE NGINX SU DISCO (secondo livello)
# =======================================================
# Varnish sta in RAM: velocissima, ma piccola e volatile - un riavvio la
# azzera e tutto il traffico piomba su PHP nello stesso istante.
# Questa sta su SSD, quindi puo' essere di gigabyte con TTL di settimane,
# e sopravvive ai riavvii di Varnish. E' lei che assorbe i MISS del primo
# livello: PHP viene toccato solo quando manca anche qui.
FASTCGI_CACHE_ENABLED=1

# Spazio massimo su disco. Oltre questa soglia nginx elimina da solo le
# voci usate meno di recente.
FASTCGI_CACHE_MAX_SIZE=2g

# Indice in RAM delle chiavi: ~8000 voci per megabyte. Non contiene le
# pagine, solo i loro riferimenti.
FASTCGI_CACHE_ZONE_SIZE=64m

# Dopo quanto una voce mai richiesta viene tolta dal disco.
FASTCGI_CACHE_INACTIVE=60d

# TTL predefinito. Puo' essere lunghissimo perche' questa cache non
# scade: viene invalidata dal plugin quando il contenuto cambia davvero.
# Il plugin puo' sovrascriverlo per singola risposta.
FASTCGI_CACHE_TTL=30d

# Installa il must-use plugin "Stack Cache", che governa i quattro
# livelli (Varnish, nginx, Redis, OPcache) dalla bacheca.
INSTALL_MU_PLUGINS=1

# =======================================================
# 4. COMPRESSIONE (zstd / brotli / gzip)
# =======================================================
# Ordine di preferenza. Varnish normalizza Accept-Encoding al primo
# formato della lista che il browser dichiara di accettare, e da quello
# dipende quante copie di ogni pagina finiscono in cache.
#
#   br,zstd,gzip  (default) massima compatibilita' e miglior rapporto
#   zstd,br,gzip            decompressione piu' rapida lato client,
#                           utile se il pubblico e' soprattutto mobile
#   gzip                    una sola variante in cache, minimo consumo
COMPRESSION_PRIORITY=br,zstd,gzip

# Livelli. Alzarli fa risparmiare byte e costare CPU ad ogni MISS; per i
# file statici il risultato viene messo in cache, per l'HTML no.
GZIP_LEVEL=6
BROTLI_LEVEL=5
ZSTD_LEVEL=6
# Sotto questa dimensione non si comprime: l'header di compressione
# costerebbe piu' dei byte risparmiati.
COMPRESSION_MIN_LENGTH=256

# =======================================================
# 5. DATABASE
# =======================================================
DB_NAME=wordpress
DB_USER=wordpress
DB_PASS=ScegliPasswordSicura
DB_ROOT_PASS=ScegliPasswordRoot
# Cambiarlo prima della prima installazione rende inutili gli script
# automatici che cercano le tabelle wp_
DB_TABLE_PREFIX=wp_

# Limite RAM del container MariaDB
DB_MEM_LIMIT=1024M
# RAM dedicata ai dati e agli indici tenuti in memoria. Se ci sta
# l'intero database, le letture non toccano piu' il disco.
DB_BUFFER_POOL=512M
DB_CONNECTIONS=200

# =======================================================
# 6. REDIS (object cache)
# =======================================================
REDIS_MEM_LIMIT=128mb
REDIS_CONTAINER_MEM=256M
# Vuoto = nessuna autenticazione (Redis resta comunque sulla sola rete
# interna). Valorizzarla e' consigliato: la define corrispondente finisce
# in wp-config.php alla prima installazione.
REDIS_PASSWORD=

# =======================================================
# 7. RISORSE WORDPRESS
# =======================================================
# Limite RAM del container nginx + PHP-FPM
WP_MEM_LIMIT=1536M
NGINX_WORKER_CONNECTIONS=4096

# =======================================================
# 8. SICUREZZA
# =======================================================
# Firewall applicativo su nginx (query string, percorsi, user agent,
# referer, metodi). 1 = attivo.
FIREWALL_ENABLED=1

# Cookie che disattiva il firewall per la tua sessione.
#
# Finche' resta il valore di esempio (o e' vuoto) il bypass e' DISATTIVATO:
# il valore qui sotto e' pubblicato in questo repository, quindi lasciarlo
# attivo significherebbe distribuire una chiave che chiunque puo' usare.
# L'entrypoint lo segnala nei log all'avvio.
#
# Solo lettere, numeri, '-' e '_': il valore finisce dentro a
# un'espressione regolare di nginx, e un carattere come '(' impedirebbe
# l'avvio del container. Anche in quel caso il bypass resta disattivato.
#
# Per attivarlo, nella console del browser (F12):
#   document.cookie = "IL-TUO-VALORE=1; path=/; SameSite=Lax; Secure";
FIREWALL_BYPASS_COOKIE=wpfw-bypass-CAMBIAMI

# XML-RPC: 0 lo chiude del tutto. E' la superficie preferita per il brute
# force amplificato (system.multicall prova centinaia di password in una
# sola richiesta). Metti 1 solo se usi Jetpack o l'app mobile.
XMLRPC_ENABLED=0

# Rate limit per IP. login e xmlrpc sono richieste/minuto, api al secondo.
RATE_LIMIT_LOGIN=20
RATE_LIMIT_XMLRPC=10
RATE_LIMIT_API=20
# Connessioni contemporanee per IP
LIMIT_CONN_PER_IP=40

# Password dell'utente admin di FileBrowser. VA IMPOSTATA: se resta
# vuota, FileBrowser parte comunque e l'utente admin resta senza
# password. Viene riapplicata ad ogni avvio del servizio "files".
FB_ADMIN_PASSWORD=ScegliPasswordFileBrowser

# =======================================================
# 9. IMMAGINI
# =======================================================
# Cartella dentro wp-content dove il plugin di conversione scrive le
# varianti AVIF/WebP. nginx le serve al posto dell'originale quando il
# browser le accetta.
#   CompressX    -> compressx-nextgen
#   WebP Express -> webp-express/webp-images/doc-root/wp-content
CONVERTED_DIR=compressx-nextgen

# =======================================================
# 10. MANUTENZIONE
# =======================================================
# 1 = al primo avvio scarica WordPress e genera wp-config.php.
# Mettere 0 quando si ripristina un sito esistente da backup.
WP_AUTO_INSTALL=1

# Chi puo' raggiungere /wp-admin/install.php e /wp-admin/setup-config.php.
#   auto - aperti solo finche' il sito non e' installato, poi 404 (default)
#   deny - sempre 404: si installa solo da CLI, con "wp core install"
#   open - sempre raggiungibili
WP_INSTALL_ACCESS=auto

# Cron eseguito da supervisord invece che dalle richieste dei visitatori
# (con Varnish davanti, a PHP arrivano troppe poche richieste perche' il
# cron interno parta con regolarita').
WP_CRON_ENABLED=true
WP_CRON_INTERVAL=60

# 1 = ad ogni avvio normalizza proprietario e permessi di tutta la
# docroot. Costa secondi su un sito grande: tenerlo a 0 e alzarlo solo
# dopo un ripristino da backup.
FIX_PERMISSIONS=0
