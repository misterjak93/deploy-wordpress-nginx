# =======================================================
# MariaDB - override per WordPress
# =======================================================
# Montato in /etc/mysql/conf.d/, non al posto di /etc/mysql/my.cnf: cosi'
# si aggiunge alla configurazione dell'immagine invece di sostituirla, e
# un aggiornamento di MariaDB non perde i suoi default.
# I parametri che dipendono dalla RAM disponibile (buffer pool, numero di
# connessioni) stanno nel comando del servizio in docker-compose.yml,
# perche' arrivano dal .env.

[mysqld]
# --- Charset ---
# utf8mb4 e' l'unico che copre emoji e caratteri fuori dal piano base.
# utf8 in MySQL/MariaDB e' a 3 byte e li tronca.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# --- Rete ---
skip-name-resolve = 1
max_allowed_packet = 128M
wait_timeout = 300
interactive_timeout = 300

# --- Query cache ---
# Spenta. Su MariaDB e' protetta da un mutex globale: con piu' di pochi
# core concorrenti fa perdere piu' tempo di quanto ne faccia risparmiare,
# e ogni scrittura su una tabella invalida tutte le query che la
# toccavano - cioe' costantemente, su WordPress. La cache delle query la
# fanno Redis (oggetti) e Varnish (pagine).
query_cache_type = 0
query_cache_size = 0

# --- InnoDB ---
# innodb_buffer_pool_instances NON e' qui: dalla 10.6 MariaDB ha un buffer
# pool unico e il parametro non ha piu' effetto. Il server lo accetta
# ancora, quindi la riga non rompeva niente - raccontava solo una
# configurazione che non esiste.
innodb_file_per_table = 1
innodb_stats_on_metadata = 0
innodb_log_buffer_size = 32M
innodb_purge_threads = 4
innodb_lock_wait_timeout = 50

# --- Tabelle temporanee ---
# WordPress genera parecchie temporanee con le query di meta e di
# tassonomia. Se superano questa soglia finiscono su disco: alzarla le
# tiene in RAM. I due valori vanno mossi insieme, vince il minore.
tmp_table_size = 64M
max_heap_table_size = 64M

# --- Buffer per connessione ---
# Sono allocati per ogni connessione: moltiplicare per max-connections
# prima di alzarli.
join_buffer_size = 2M
sort_buffer_size = 2M
read_rnd_buffer_size = 1M

# --- Cache di tabelle e thread ---
table_open_cache = 4000
table_definition_cache = 2000
thread_cache_size = 64

# --- Log delle query lente ---
# Il posto dove si scopre quale plugin sta facendo la scansione completa
# di wp_postmeta.
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 0

[client]
default-character-set = utf8mb4
