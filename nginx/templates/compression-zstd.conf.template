# --- Zstandard: decompressione molto piu' rapida a parita' di rapporto ---
# Il vantaggio si vede sul client: decomprimere zstd costa al browser una
# frazione di Brotli, e su mobile di fascia bassa quel tempo entra dritto
# nel Largest Contentful Paint. Chrome/Edge 123+ e Firefox 126+ lo
# annunciano; chi non lo fa riceve Brotli o gzip.
zstd                on;
zstd_comp_level     ${ZSTD_LEVEL};
zstd_min_length     ${COMPRESSION_MIN_LENGTH};
zstd_static         on;
zstd_types
    text/plain text/css text/xml text/javascript text/x-component text/calendar
    application/javascript application/x-javascript application/json
    application/xml application/xml+rss application/rss+xml application/atom+xml
    application/ld+json application/manifest+json application/vnd.ms-fontobject
    application/wasm application/x-font-ttf
    font/ttf font/otf image/svg+xml image/x-icon;
